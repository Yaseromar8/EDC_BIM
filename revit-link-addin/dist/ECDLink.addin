<?xml version="1.0" encoding="utf-8"?>
<RevitAddIns>
  <AddIn Type="Application">
    <Name>ECD Link</Name>
    <!-- Ruta RELATIVA al manifiesto: el instalador copia la DLL a la subcarpeta
         ECDLink dentro de Addins\2023, así funciona para CUALQUIER usuario. -->
    <Assembly>ECDLink\ECDLink.dll</Assembly>
    <AddInId>7E3C1A52-9D4B-4B0E-A9F1-3C5D82E10230</AddInId>
    <FullClassName>ECDLink.ECDLinkApp</FullClassName>
    <VendorId>ECD</VendorId>
    <VendorDescription>ECD-VISIION — Live Link Web/Revit</VendorDescription>
  </AddIn>
</RevitAddIns>
