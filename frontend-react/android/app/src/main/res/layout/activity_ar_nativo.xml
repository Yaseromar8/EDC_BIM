<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/ar_fragment"
        android:name="com.google.ar.sceneform.ux.ArFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Aviso de tracking: cuando ARCore pierde el mapa, la camara virtual se
         congela y todo lo virtual queda pegado a la pantalla ("el modelo me
         sigue"). Se oculta el modelo y este letrero explica como recuperar. -->
    <TextView
        android:id="@+id/aviso_tracking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="#D9271C2C"
        android:textColor="#FFD9A8"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- ESTACION LIBRE: medir puntos de control con el reticulo central.
         Solo visible si el proyecto trae puntos (via Intent). Con 2+ medidos
         el modelo aparece georreferenciado SOLO, con su cierre en cm. -->
    <TextView
        android:id="@+id/reticula_geo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="＋"
        android:textSize="34sp"
        android:textColor="#FFC83D"
        android:shadowColor="#000000"
        android:shadowRadius="6"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/barra_medicion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="70dp"
        android:orientation="horizontal"
        android:background="#B31C1C27"
        android:padding="6dp"
        android:visibility="gone">

        <Spinner
            android:id="@+id/sel_punto"
            android:layout_width="150dp"
            android:layout_height="44dp"
            android:backgroundTint="#E6E6F0" />

        <Button
            android:id="@+id/btn_medir"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="📍 Medir aquí"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F8A4C" />

        <TextView
            android:id="@+id/txt_geo_estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:textColor="#BFE8CF"
            android:textSize="12sp"
            android:text="0 medidos" />
    </LinearLayout>

    <!-- AJUSTE DE CAMPO: mover/girar el modelo YA colocado para referenciarlo
         contra la obra real. Botones con paso conocido (1 m / 10 cm / 1 cm),
         no gestos: en un modelo de 50 m un arrastre tactil es ambiguo y se
         dispara sin querer. Solo visible con modelo colocado. -->
    <LinearLayout
        android:id="@+id/barra_ajuste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="86dp"
        android:orientation="horizontal"
        android:background="#B31C1C27"
        android:padding="6dp"
        android:visibility="gone">

        <Button android:id="@+id/btn_girar_izq" android:layout_width="52dp" android:layout_height="44dp"
            android:text="⟲" android:textSize="18sp" android:textColor="#E6E6F0" android:backgroundTint="#3A3A46"/>
        <Button android:id="@+id/btn_girar_der" android:layout_width="52dp" android:layout_height="44dp"
            android:layout_marginStart="4dp" android:text="⟳" android:textSize="18sp" android:textColor="#E6E6F0" android:backgroundTint="#3A3A46"/>
        <Button android:id="@+id/btn_mov_izq" android:layout_width="52dp" android:layout_height="44dp"
            android:layout_marginStart="12dp" android:text="◀" android:textColor="#E6E6F0" android:backgroundTint="#2C3A50"/>
        <Button android:id="@+id/btn_mov_lejos" android:layout_width="52dp" android:layout_height="44dp"
            android:layout_marginStart="4dp" android:text="▲" android:textColor="#E6E6F0" android:backgroundTint="#2C3A50"/>
        <Button android:id="@+id/btn_mov_cerca" android:layout_width="52dp" android:layout_height="44dp"
            android:layout_marginStart="4dp" android:text="▼" android:textColor="#E6E6F0" android:backgroundTint="#2C3A50"/>
        <Button android:id="@+id/btn_mov_der" android:layout_width="52dp" android:layout_height="44dp"
            android:layout_marginStart="4dp" android:text="▶" android:textColor="#E6E6F0" android:backgroundTint="#2C3A50"/>
        <Button android:id="@+id/btn_subir" android:layout_width="wrap_content" android:layout_height="44dp"
            android:layout_marginStart="12dp" android:text="Subir" android:textColor="#E6E6F0" android:backgroundTint="#3A3A46"/>
        <Button android:id="@+id/btn_bajar" android:layout_width="wrap_content" android:layout_height="44dp"
            android:layout_marginStart="4dp" android:text="Bajar" android:textColor="#E6E6F0" android:backgroundTint="#3A3A46"/>
        <Button android:id="@+id/btn_paso" android:layout_width="wrap_content" android:layout_height="44dp"
            android:layout_marginStart="12dp" android:text="paso: 10 cm" android:textColor="#FFE9A8" android:backgroundTint="#4A3A24"/>
    </LinearLayout>

    <!-- Veredicto con numeros: fps + posicion de la camara. Si los numeros no
         cambian al mover la tablet = rastreo solo-rotacion (luz/piso). -->
    <TextView
        android:id="@+id/hud_diag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="#99101318"
        android:textColor="#8FE3A8"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- Botonera de escala: chips abajo al centro, estilo obra (oscuro).
         1:1 = enterrado real bajo el piso; maquetas = apoyadas SOBRE el piso. -->
    <LinearLayout
        android:id="@+id/barra_escalas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal"
        android:background="#B31C1C27"
        android:padding="6dp">

        <Button
            android:id="@+id/btn_escala_real"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="1:1"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E6BE6" />

        <Button
            android:id="@+id/btn_escala_100"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:text="1:100"
            android:textColor="#E6E6F0"
            android:backgroundTint="#3A3A46" />

        <Button
            android:id="@+id/btn_escala_200"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:text="1:200"
            android:textColor="#E6E6F0"
            android:backgroundTint="#3A3A46" />

        <Button
            android:id="@+id/btn_quitar"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:text="Quitar"
            android:textColor="#FFB4B4"
            android:backgroundTint="#3A2430" />
    </LinearLayout>
</FrameLayout>
