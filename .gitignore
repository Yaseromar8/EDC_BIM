.env
node_modules/
.DS_Store
__pycache__/
*.pyc

# Build output (Netlify rebuilds from source; committed dist is redundant)
frontend-react/dist/
frontend-docs/dist/
# Agent runtime logs (were causing Windows file-lock issues on checkout/reset)
.codex/

# Ignore environment and sensitive files
backend/venv/
# Credenciales de cuenta de servicio de Google. CUALQUIER variante.
# Estaban listadas por nombre exacto (gcp_sa.json), asi que un fichero
# llamado gcp_sa_ensayo.json --creado para el gate del 20-ago-2026-- NO
# quedaba ignorado, y en esta misma sesion se estaban haciendo `git add -A
# backend/`. Una clave privada a un commit por un sufijo.
gcp_sa*.json
backend/gcp_sa*.json
**/gcp_sa*.json
*-service-account*.json
backend/gcp_sa.json
gcp_sa.json
*.env
push_err*.txt
push_error.txt
status.txt
test_out.txt

backend/uploads/documents/*.mp4

# Entornos virtuales de Python (cualquier variante). Faltaba 'venv2' y por eso
# se colaron 6.400 ficheros del entorno entero en un commit.
backend/venv*/
venv*/
.venv/

# Salidas de compilacion y artefactos pesados
backend/civil_app_bundle/bin/
backend/civil_app_bundle/obj/
backend/civil_app_bundle/*.zip
frontend-react/dist_apk/
frontend-react/dist_field/
frontend-react/dist_old/
frontend-react/dist_check/
frontend-docs/dist_check/
revit-link-addin/*.zip

# Informes y scratch de depuracion (se generan, no se versionan)
backend/da_report*.txt
backend/da_debug*.txt
backend/error_log.txt
backend/last_report.txt
backend/grep_urn.txt
backend/test_output*.txt
backend/scratch_*.py

# Guiones sueltos de diagnostico y artefactos de compilacion del bundle de Civil 3D.
# Se colaron dos veces en un commit por un 'git add backend/' a lo bruto.
backend/fix*.py
backend/get_token.py
backend/dump_schema.py
backend/test_engines.py
backend/section_v2_sample.json
backend/civil_app_bundle/**/Contents/
backend/civil_app_bundle/check_zip*/
backend/civil_app_bundle/*.csproj
backend/civil_app_bundle/check_wi.py
backend/civil_app_bundle/test_workitem.py
backend/civil_app_bundle/trigger_extraction.py
backend/civil_app_bundle/test_output2.txt
backend/forge-civil3d-properties/
fix_documents.py

# Guiones de mantenimiento con datos de conexion escritos dentro.
# Los siete que habia (scratch, clean_*, diagnose_*, test_full_flow) llevaban
# el host y la contrasena de PRODUCCION en la primera linea, y son el camino
# por el que se modifico el registro de auditoria sin pasar por la aplicacion.
# Se retiraron el 13-ago-2026. Si hace falta una herramienta de mantenimiento,
# va en backend/herramientas/ y lee la conexion del entorno, nunca del codigo.
backend/scratch*.py
backend/clean_*.py
backend/diagnose_*.py
backend/test_full_flow.py

# Guiones sueltos de depuracion con credenciales dentro. Retirados el 15-ago-2026:
# apuntaban a localhost/visor_aps con la contrasena escrita en el fichero, y
# estaban PUBLICADOS en el repositorio. Ninguno lo importaba nadie.
# El peligro de esta familia no es lo que hace cada guion: es que puentean la
# aplicacion, que es el camino por el que se pudo alterar el registro de
# auditoria sin dejar rastro (C3).
backend/debug_photos.py
backend/check_cats.py

# Copias de seguridad locales: datos reales, nunca al repositorio.
copias/

# Planos del banco de pruebas del lector (probar-lector.html): pesan MB y
# son documentos de obra, no van al repositorio. Se copian a mano:
#   cp PDF/<plano>.pdf frontend-docs/public/_probar/plano-A.pdf   (y B, C)
frontend-docs/public/_probar/

# Recursos de pdf.js copiados del paquete instalado al empaquetar
# (ver vite.config.js). Vienen de node_modules: no se versionan.
frontend-docs/public/pdfjs/
